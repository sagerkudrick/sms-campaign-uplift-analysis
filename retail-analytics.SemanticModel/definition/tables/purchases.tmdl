table purchases
	lineageTag: df852ad7-7d4b-4a2c-9afe-8b9d91e459a1

	measure 'Total Spend' = SUM(purchases[Total Purchase])
		formatString: #,0
		displayFolder: Spend
		lineageTag: 917c6d45-eeb1-4778-ad18-1c5cfc804c4f

	measure 'Customers With Purchases' = DISTINCTCOUNT(purchases[client_id])
		formatString: #,0
		displayFolder: Spend
		lineageTag: d7c8b8bc-5d13-488a-bfd9-119e01ac0124

	measure 'Avg Spend per Customer' = DIVIDE([Total Spend], [Customers With Purchases])
		formatString: #,0.00
		displayFolder: Spend
		lineageTag: 4c1536de-fa38-48ea-8682-c4cfb8d8466f

	measure 'Points Spent to Received Ratio' = DIVIDE(SUM(purchases[Total Points Spent]), SUM(purchases[Total Points Received]))
		formatString: 0.00
		displayFolder: Spend
		lineageTag: 27e46ce3-93ec-458b-bcae-b05760f0cd70

	measure 'Bad Value Rows' = COUNTROWS(FILTER(purchases, purchases[Check Values] = "BAD VALUE"))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: ee5c5399-f942-4c5e-92e2-8351d8af884d

	measure 'Median Spend per Customer' = MEDIAN(purchases[Total Purchase])
		formatString: #,0
		displayFolder: Spend
		lineageTag: bb5735ea-b9e2-4674-8e01-9b1e3c201a64

	/// Share of customers who spent any regular loyalty points in the purchase history.
	measure 'Share Redeeming Points' = DIVIDE(COUNTROWS(FILTER(purchases, purchases[Total Points Spent] > 0)), COUNTROWS(purchases))
		formatString: 0%
		displayFolder: Spend
		lineageTag: 06d7643b-4cde-4eb3-a5db-f7b7b5579cd1

	measure 'Share of Total Spend' = DIVIDE([Total Spend], CALCULATE([Total Spend], ALL(purchases)))
		formatString: 0.0%
		displayFolder: Spend
		lineageTag: 69b5e637-7652-4877-a220-581e59b61d4b

	/// Median number of purchase receipts per customer in the pre-campaign history.
	measure 'Median Transactions per Customer' = MEDIAN(purchases[Transactions])
		formatString: #,0
		displayFolder: Spend
		lineageTag: fd985209-6988-47cf-acc7-b3257794dc63

	column client_id
		dataType: string
		lineageTag: b347ce71-414b-4433-afe9-aa8f9d3e46e9
		summarizeBy: none
		sourceColumn: client_id

		annotation SummarizationSetBy = Automatic

	column 'Total Points Received'
		dataType: double
		formatString: #,0
