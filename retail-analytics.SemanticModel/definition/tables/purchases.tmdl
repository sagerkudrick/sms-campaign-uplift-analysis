		summarizeBy: sum
		sourceColumn: Total Points Received

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Total Points Spent'
		dataType: double
		formatString: #,0
		lineageTag: 41716ac3-6848-4288-9d4d-49a5835ea0f4
		summarizeBy: sum
		sourceColumn: Total Points Spent

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Total Express Received'
		dataType: double
		formatString: #,0
		lineageTag: f0458cbf-3f2f-4fa8-940f-3e5229789353
		summarizeBy: sum
		sourceColumn: Total Express Received

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Total Express Spent'
		dataType: double
		formatString: #,0
		lineageTag: 9cce2fd0-3e69-4707-8997-f4ad9f6e9bf5
		summarizeBy: sum
		sourceColumn: Total Express Spent

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Total Product Bought'
		dataType: double
		formatString: #,0
		lineageTag: ce3095db-c49a-467c-a304-ac8b5d36149e
		summarizeBy: sum
		sourceColumn: Total Product Bought

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Total Purchase'
		dataType: double
		formatString: #,0
		lineageTag: 32fc4f40-ba60-4584-a20c-5ee0a6f3eb3e
		summarizeBy: sum
		sourceColumn: Total Purchase

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Check Values'
		dataType: string
		isHidden
		lineageTag: a75f2f3b-af22-4a6b-9c9e-6021bb999cf2
		summarizeBy: none
		sourceColumn: Check Values

		annotation SummarizationSetBy = Automatic

	column 'Spend Band Order' = SWITCH(TRUE(), purchases[Total Purchase] < 2000, 1, purchases[Total Purchase] < 5000, 2, purchases[Total Purchase] < 10000, 3, purchases[Total Purchase] < 20000, 4, 5)
		dataType: int64
		isHidden
		displayFolder: Segments
		lineageTag: e80ec3eb-8bf0-448a-a263-72d3c3375487
		summarizeBy: none

	/// Total pre-campaign spend per customer (rubles), banded.
	column 'Spend Band' = SWITCH(purchases[Spend Band Order], 1, "Under 2k", 2, "2k-5k", 3, "5k-10k", 4, "10k-20k", "20k+")
		dataType: string
		displayFolder: Segments
		lineageTag: b62486f2-bfc2-438a-904b-f22265b157a9
		summarizeBy: none
		sortByColumn: 'Spend Band Order'

	/// Spend quartile, with cut points taken from campaign clients that have purchase history.
	column 'Spend Quartile No' =
			VAR _s = purchases[Total Purchase]
			RETURN SWITCH(TRUE(), _s <= MAX('Spend Quartile Cuts'[Q1]), 1, _s <= MAX('Spend Quartile Cuts'[Q2]), 2, _s <= MAX('Spend Quartile Cuts'[Q3]), 3, 4)
		dataType: int64
		isHidden
		displayFolder: Segments
		lineageTag: 60865e98-6f4e-41bd-b525-86090d36eee2
		summarizeBy: none

	/// Pre-campaign spend quartile (rubles). Cut points from campaign clients with purchase history.
	column 'Spend Quartile' =
			VAR _q1 = FORMAT(MAX('Spend Quartile Cuts'[Q1]), "#,0")
			VAR _q2 = FORMAT(MAX('Spend Quartile Cuts'[Q2]), "#,0")
			VAR _q3 = FORMAT(MAX('Spend Quartile Cuts'[Q3]), "#,0")
			RETURN SWITCH(purchases[Spend Quartile No], 1, "Q1: under " & _q1, 2, "Q2: " & _q1 & "-" & _q2, 3, "Q3: " & _q2 & "-" & _q3, "Q4: over " & _q3)
		dataType: string
		displayFolder: Segments
		lineageTag: 8541db9e-19eb-4cec-a3d5-7e50618f608c
		summarizeBy: none
		sortByColumn: 'Spend Quartile No'

	/// Number of purchase transactions (receipts) in the pre-campaign history.
	column Transactions
		dataType: int64
		formatString: #,0
		lineageTag: 549f83fa-3973-4059-8454-b371c7c915d2
		summarizeBy: sum
		sourceColumn: Transactions

	partition purchases = m
		mode: import
		source =
				// One row per customer, built in SQL Server by mart.usp_build_marts (see sql/03_build_marts.sql)
				let
				    Source = Sql.Database("localhost,14333", "uplift"),
				    mart_client_purchases = Source{[Schema = "mart", Item = "client_purchases"]}[Data],
				    #"Renamed Columns" = Table.RenameColumns(mart_client_purchases, {{"total_points_received", "Total Points Received"}, {"total_points_spent", "Total Points Spent"}, {"total_express_received", "Total Express Received"}, {"total_express_spent", "Total Express Spent"}, {"total_product_bought", "Total Product Bought"}, {"total_purchase", "Total Purchase"}, {"transactions", "Transactions"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"Total Points Received", type number}, {"Total Points Spent", type number}, {"Total Express Received", type number}, {"Total Express Spent", type number}, {"Total Product Bought", type number}, {"Total Purchase", type number}, {"Transactions", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Check Values", each if [Total Purchase] = null then "BAD VALUE" else "OK", type text)
				in
				    #"Added Custom"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

